<%- include('includes/head') %> <%- include('includes/navbar') %>

<div class="container">
  <div class="row">
    <div class="col-lg-2"></div>

    <div class="col-lg-8">
      <h1 class="text-center">Criar Conta ou Entrar</h1>
      <p class="text-center lead">Faça seu Login ou crie sua conta abaixo</p>

      <div class="row">
        <div class="col-lg">
          <h4>Faça seu cadastro</h4>
          <p>Se você ainda não tem conta, preencha o formulario abaixo</p>

          <form action="/login/register" method="POST">
            <input type="hidden" name="_csrf" value=<%= csrfToken %>>
            <div class="form-group">
              <label>Seu E-mail</label>
              <input type="email" class="form-control" name="email" />
            </div>
            <div class="form-group">
              <label>Sua Senha</label>
              <input type="password" class="form-control" name="password" />
            </div>

            <button type="submit" class="btn btn-primary">Entrar</button>
          </form>
        </div>
        <div class="col-lg">
          <h4>Entra no sistema</h4>
          <p>Se você ainda não tem conta, faça login abaixo</p>

          <form action="/login/login" method="post">
            <div class="form-group">
              <label>Seu E-mail</label>
              <input type="email" class="form-control" name="email" />
            </div>
            <div class="form-group">
              <label>Sua Senha</label>
              <input type="password" class="form-control" name="password" />
            </div>

            <button type="submit" class="btn btn-primary">Criar Conta</button>
          </form>
        </div>
      </div>
    </div>
    <div class="col-lg-2"></div>
  </div>

  <%- include('includes/footer') %>
</div>
