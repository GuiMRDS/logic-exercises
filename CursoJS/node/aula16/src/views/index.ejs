<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <title>Modelo</title>
    <link rel="stylesheet" href="./assets/css/style.css" />
  </head>

  <body>
    <section class="container">
      <h1>
        
        <% for(let i = 0; i < numeros.length; i++) { %>
          <%= numeros[i] %> <br>
        <% }; %> 
    
